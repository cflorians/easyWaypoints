{
	"schemaVersion": 1,
	"id": "easywp",
	"version": "${version}",
	"name": "easyWp",
	"description": "A lightweight, minimalist, and non-intrusive waypoints mod. Highlights include a quick-toggle visibility hotkey, individual hide and focus options, native pixel-perfect occlusion, and shader-fog bypass.",
	"authors": [
		"Carlos Florian"
	],
	"contact": {
		"homepage": "https://github.com/cflorians/easyWaypoints",
		"sources": "https://github.com/cflorians/easyWaypoints"
	},
	"license": "CC0-1.0",
	"icon": "assets/easywp/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.easywp.EasyWp"
		],
		"client": [
			"com.easywp.client.EasyWpClient"
		]
	},
	"mixins": [
		"easywp.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.1",
		"java": ">=25",
		"fabric-api": "*"
	}
}