{
	"schemaVersion": 1,
	"id": "easywp",
	"version": "${version}",
	"name": "Easy Waypoints",
	"description": "Minimalist, pixel-perfect, zero-dependency waypoints for Minecraft.",
	"authors": [
		"cflorians"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/easywp",
		"sources": "https://github.com/cflorians/easyWaypoints"
	},
	"license": "MIT",
	"icon": "assets/easywp/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.easywp.EasyWp"
		],
		"client": [
			"com.easywp.client.EasyWpClient"
		]
	},
	"mixins": [
		"easywp.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": ">=1.21.9 <=1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}